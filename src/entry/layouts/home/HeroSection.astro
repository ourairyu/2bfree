---
import banner from './banner.jpg';
import DataOverview from './DataOverview.astro';
---

<header class="HeroSection h-[640px] bg-no-repeat bg-center bg-cover" style={`background-image: url("${banner.src}");`}>
  <div class="HeroSection-content max-w-screen-xl mx-auto flex flex-col items-center justify-center">
    <div class="mb-6 text-white">
      <h1 class="text-inherit" style="text-shadow: 3px 3px 24px #000;">
        <span>欧雷的</span>
        <span class="block text-6xl sm:text-8xl font-extrabold">破局之路</span>
      </h1>
      <p class="text-right"><span class="block">记述 35 岁大厂失业中年男人</span>突破逆境通往自由的成长历程</p>
    </div>
    <DataOverview />
  </div>
</header>

<style>
  .HeroSection {
    position: relative;
  }

  .HeroSection::before,
  .HeroSection-content {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
  }

  .HeroSection::before {
    content: "\0020";
    background-color: #000;
    opacity: .35;
  }
</style>
