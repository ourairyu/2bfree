---
import banner from './banner.jpg';
import DataOverview from './DataOverview.astro';
---

<header class="HeroSection bg-no-repeat bg-center bg-cover sm:h-[640px]" style={`background-image: url("${banner.src}");`}>
  <div class="HeroSection-content max-w-screen-xl mx-auto flex flex-col items-center justify-center max-sm:!relative max-sm:pt-16 max-sm:pb-9">
    <div class="text-white max-sm:mb-9">
      <h1 class="text-inherit" style="text-shadow: 3px 3px 24px #000;">
        <span>欧雷的</span>
        <span class="block mt-2 text-6xl sm:text-8xl font-extrabold">破局之路</span>
      </h1>
      <p class="mb-0 leading-6 text-center max-sm:mt-4 sm:text-right"><span class="block">记述 35 岁大厂失业中年男人</span>突破逆境通往自由的成长历程</p>
    </div>
    <DataOverview class="sm:absolute sm:bottom-9" />
  </div>
</header>

<style>
  .HeroSection {
    position: relative;
  }

  .HeroSection::before,
  .HeroSection-content {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
  }

  .HeroSection::before {
    content: "\0020";
    background-color: #000;
    opacity: .35;
  }
</style>
