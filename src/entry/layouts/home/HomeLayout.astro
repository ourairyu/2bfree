import HeroSection from './HeroSection.astro';
import IntroSection from './IntroSection.astro';
import AudienceSection from './AudienceSection.astro';
import SellingSection from './SellingSection.astro';
---

<DefaultLayout>
  <article class="pb-14">
    <HeroSection />
    <div class="max-w-screen-xl mx-auto mt-24 px-4">
      <IntroSection />
      <AudienceSection class="mt-24" />
      <SellingSection class="mt-24" />
    </div>
  </article>
</DefaultLayout>
