---
import { getBoughtCount } from '@/utils/column';

interface Props {
  class?: string;
  style?: string;
}

const { class: customClass, style } = Astro.props;

const indexes = [
  { label: '购买专栏人数', value: getBoughtCount(), unit: '人' },
  { label: '已更新文章数', value: 39, unit: '篇' },
  { label: '每月更新频率', value: '1～4', unit: '篇' },
  { label: '预估截止日期', value: '2032', unit: '年' },
];
---

<div class:list={['grid grid-cols-2 p-4 rounded-[36px] shadow-2xl bg-white opacity-80 sm:grid-cols-4 sm:rounded-full', customClass]} style={style}>
  {indexes.map(index => (
    <div class="DataIndex flex flex-col items-center px-4 max-sm:py-2">
      <div class="DataIndex-value text-4xl font-semibold">{index.value}<span class="ml-1 text-medium font-normal">{index.unit}</span></div>
      <div class="DataIndex-label mt-1 text-sm font-light">{index.label}</div>
    </div>
  ))}
</div>

<style>
  @media (min-width: 640px) {
    .DataIndex + .DataIndex {
      border-left: 1px solid #eee;
    }
  }
</style>
