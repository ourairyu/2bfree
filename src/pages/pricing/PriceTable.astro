---
const priceList = [
  {
    label: '1～52',
    value: ['-', '198.8'],
  },
  {
    label: '53～222',
    value: ['198.8', '999'],
  },
  {
    label: '223～1000',
    value: ['365', '1988'],
  },
  {
    label: '1001～∞',
    value: ['365', '-'],
  },
];
const currentIndex = 0;
---

<div class="box-border p-4 border-1 overflow-hidden rounded-lg bg-white shadow-xl">
  <div>
    <div class="grid grid-cols-3 items-center font-bold">
      <div class="p-3"></div>
      <div class="p-3 border-x-1 text-center">
        <span class="text-lg">订阅<span class="block text-sm text-neutral-500 font-normal">（按年）</span></span>
      </div>
      <div class="p-3 text-center">
        <span class="text-lg">买断<span class="block text-sm text-neutral-500 font-normal">（限 1000 份）</span></span>
      </div>
    </div>
  </div>
  <div>
    {priceList.map((price, idx) => (
      <div class:list={['grid grid-cols-3 items-center border-t-1', idx === currentIndex ? 'bg-[#0871ab] text-white rounded-lg' : 'text-neutral-400']}>
        <div class="p-3 text-right">第 {price.label} 份</div>
        <div class="p-3 border-x-1 text-center">{price.value[0]}</div>
        <div class="p-3 text-center">{price.value[1]}</div>
      </div>
    ))}
  </div>
</div>
